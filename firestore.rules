rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Storage rules for profile images
    service firebase.storage {
      match /b/{bucket}/o {
        match /profile-images/{userId}/{allPaths=**} {
          allow read: if request.auth != null;
          allow write: if request.auth.uid == userId && request.resource.size < 5242880;
          allow delete: if request.auth.uid == userId;
        }
      }
    }
    function isSignedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function role() {
      return isSignedIn() && userDoc().exists() ? userDoc().data.role : null;
    }

    function isAdmin() {
      return role() == "admin";
    }

    function isCounsellor() {
      return role() == "counsellor";
    }

    function isStudent() {
      return role() == "student";
    }

    function isChatParticipant(chatId) {
      return isSignedIn() &&
        chatId != null &&
        exists(/databases/$(database)/documents/chats/$(chatId)) &&
        request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
    }

    function isConversationParticipant(conversationId) {
      return isSignedIn() &&
        conversationId != null &&
        exists(/databases/$(database)/documents/conversations/$(conversationId)) &&
        request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
    }

    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    match /conversations/{conversationId} {
      allow create: if isSignedIn() &&
        request.auth.uid in request.resource.data.participants;
      allow read, update: if isSignedIn() &&
        request.auth.uid in resource.data.participants;
      allow delete: if isSignedIn() && isAdmin();
    }

    match /student_data/{userId} {
      allow read, write: if isSignedIn() && (request.auth.uid == userId || isAdmin());
    }

    match /dailyMetrics/{docId} {
      allow create, write: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow read: if isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        isAdmin()
      );
    }

    match /assessments/{assessmentId} {
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow read: if isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        isAdmin() ||
        (
          isCounsellor() &&
          resource.data.counsellorId == request.auth.uid
        )
      );
      allow update, delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    match /dailyActivities/{docId} {
      allow create, write: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow read: if isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        isAdmin()
      );
    }

    match /progress/{docId} {
      allow create, write: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow read: if isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        isAdmin()
      );
    }

    match /appointments/{appointmentId} {
      allow create: if isSignedIn();
      allow read: if isSignedIn() && (
        resource.data.studentId == request.auth.uid ||
        resource.data.counsellorId == request.auth.uid ||
        isAdmin()
      );
      allow update: if isSignedIn() && (
        resource.data.studentId == request.auth.uid ||
        resource.data.counsellorId == request.auth.uid ||
        isAdmin()
      );
      allow delete: if isSignedIn() && (
        resource.data.counsellorId == request.auth.uid ||
        isAdmin()
      );
    }

    match /chats/{chatId} {
      allow create: if isSignedIn() &&
        request.auth.uid in request.resource.data.participants;
      allow update: if isSignedIn() &&
        request.auth.uid in resource.data.participants;
      allow read: if isSignedIn() && (
        request.auth.uid in resource.data.participants ||
        isAdmin()
      );

      match /messages/{messageId} {
        allow create: if isSignedIn() &&
          request.auth.uid == request.resource.data.senderId &&
          isChatParticipant(chatId);
        allow read: if isSignedIn() && (
          isChatParticipant(chatId) ||
          isAdmin()
        );
      }
    }

    match /messages/{messageId} {
      allow create: if isSignedIn() &&
        request.auth.uid == request.resource.data.senderId &&
        (
          isChatParticipant(request.resource.data.chatId) ||
          isConversationParticipant(request.resource.data.conversationId)
        );
      allow read: if isSignedIn() && (
        resource.data.senderId == request.auth.uid ||
        resource.data.receiverId == request.auth.uid ||
        isChatParticipant(resource.data.chatId) ||
        isConversationParticipant(resource.data.conversationId) ||
        isAdmin()
      );
    }
  }
}
